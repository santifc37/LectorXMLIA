# Copia este archivo como ".env" y completa los valores.
# El archivo .env nunca se sube al repositorio.

# Clave de la API de Gemini (Google AI Studio)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (opcional)
GEMINI_MODEL=gemini-3.6-flash

# URL base de la API de la ferretería, sin barra final al terminar.
# Ejemplo: https://mi-api.ejemplo.com
API_URL=

# Comparación de precios: ¿el "precio de compra" guardado en tu inventario
# ya incluye el IVA?
#   false = el inventario guarda el costo SIN IVA (valor por defecto)
#   true  = el inventario guarda el costo CON IVA
PRECIO_COMPRA_INCLUYE_IVA=false
